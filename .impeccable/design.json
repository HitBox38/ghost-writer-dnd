      "html": "<button class=\"ds-button ds-primary ds-focus\">Generate lines</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:9px 13px;border-radius:6px;border:1px solid transparent;font-family:var(--font-interface,'Source Sans 3'),sans-serif;font-size:15px;font-weight:500;cursor:pointer}.ds-button:active{transform:translateY(1px)}.ds-focus:focus-visible{outline:2px solid var(--ring,#762f3a);outline-offset:3px}.ds-primary{background:var(--primary,#762f3a);color:var(--primary-foreground,#fff9f2)}.ds-primary:hover{background:color-mix(in oklab,var(--primary,#762f3a) 80%,transparent)}.ds-primary:disabled{background:var(--muted,#e9e6df);color:var(--muted-foreground,#656166);border-color:var(--border,#d4cfc7);cursor:not-allowed}"
    },
